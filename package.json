{
  "name": "official-daily-banana",
  "version": "1.0.0",
  "description": "Official Daily Banana repo",
  "main": "index.js",
  "scripts": {
    "lint": "npm run lint:md && npm run lint:format",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore _site",
    "lint:format": "prettier --check '**/*.{js,css,json,md,html}'",
    "format": "prettier --write '**/*.{js,css,json,md,html}'",
    "test": "npm run lint && npm run test:links && npm run test:a11y",
    "test:links": "find . -name \"*.md\" ! -path \"./node_modules/*\" ! -path \"./_site/*\" -exec markdown-link-check {} +",
    "test:a11y": "pa11y -c pa11y.json https://github.oswind.xyz/official-daily-banana/"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "htmlhint": "^1.9.2",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli": "^0.49.1",
    "pa11y": "^9.1.1",
    "prettier": "^3.9.6"
  }
}